{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Seoul",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "ignoreTests": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "pinDigests": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the agg release pinned via the AGG_VERSION build arg",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG AGG_VERSION=(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "asciinema/agg",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track the Playwright MCP server. Both pins must move together: the Dockerfile derives the bundled Chromium from this version, and codex-config.toml must request the same one",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)codex-config\\.toml$/"
      ],
      "matchStrings": [
        "PLAYWRIGHT_MCP_VERSION=(?<currentValue>[0-9][0-9.]*)",
        "@playwright/mcp@(?<currentValue>[0-9][0-9.]*)"
      ],
      "depNameTemplate": "@playwright/mcp",
      "datasourceTemplate": "npm"
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Automerge non-major dependency updates after the required repository checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge lock file maintenance after the required repository checks pass; release age does not apply because no individual release is selected",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Take @playwright/mcp immediately. The image derives its Chromium from this pin and the build launches the browser, so holding the pin back only prolongs a mismatch with upstream",
      "matchDepNames": ["@playwright/mcp"],
      "minimumReleaseAge": null
    },
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies"
    }
  ]
}
