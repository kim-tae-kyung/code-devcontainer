#!/bin/bash
# Open the Pod's Herdr session from `kubectl exec -it`. kubectl starts the
# command before the container runtime applies the client's terminal size, and
# Herdr refuses a zero-sized terminal at startup
# (https://github.com/herdrdev/herdr/issues/3777), so wait for the size first.
set -euo pipefail

for _ in {1..250}; do
    read -r rows cols < <(stty size 2>/dev/null) || break
    (( rows > 0 && cols > 0 )) && break
    sleep 0.02
done
exec herdr "$@"
